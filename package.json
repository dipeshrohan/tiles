{
  "name": "tiles",
  "version": "1.1.0",
  "description": "Tiles: factory model, virtual sensors, root-cause analysis and design studies for industrial teams.",
  "type": "module",
  "private": true,
  "scripts": {
    "version:check": "node scripts/version.js check",
    "start": "node server.js",
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc -p .",
    "lint": "eslint . && prettier --check . && node scripts/check-inline-styles.js && node scripts/check-i18n.js && node scripts/i18n-escape.js && node scripts/check-format.js",
    "format": "prettier --write . && vite build",
    "test": "vitest run",
    "test:e2e": "node --test --test-concurrency=1 --test-timeout=600000 e2e/*.test.js",
    "icons": "node scripts/icons.js",
    "glossary": "node scripts/glossary.js",
    "study": "node scripts/study.js",
    "test:visual": "node scripts/visual.js",
    "test:perf": "node --test --test-concurrency=1 --test-timeout=600000 e2e/perf/*.test.js"
  },
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "axe-core": "4.14.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "lighthouse": "13.5.0",
    "lucide-static": "1.60.0",
    "playwright": "1.64.1",
    "prettier": "^3.9.10",
    "typescript": "~6.0",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
