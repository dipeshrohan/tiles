{
  "name": "tiles",
  "version": "0.1.0",
  "description": "Tiles: factory model, virtual sensors, root-cause analysis and design studies for industrial teams.",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "build": "node build.js",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write . && node build.js",
    "test": "node build.js --check && node --test test/*.test.js",
    "test:e2e": "node --test --test-concurrency=1 e2e/*.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "playwright": "1.56.1",
    "prettier": "^3.9.9"
  }
}
