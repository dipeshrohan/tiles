{
  "name": "tiles",
  "version": "0.1.0",
  "description": "Tiles: factory model, virtual sensors, root-cause analysis and design studies for industrial teams.",
  "type": "module",
  "private": true,
  "scripts": {
    "version:check": "node scripts/version.js check",
    "start": "node server.js",
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc -p .",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write . && vite build",
    "test": "vitest run",
    "test:e2e": "node --test --test-concurrency=1 --test-timeout=600000 e2e/*.test.js"
  },
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "axe-core": "4.13.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "playwright": "1.56.1",
    "prettier": "^3.9.9",
    "typescript": "~6.0",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
